# Meta (Facebook) Pixel ID — public by design, safe to expose client-side.
NEXT_PUBLIC_META_PIXEL_ID=1033839962840918

# --- Seller lead email delivery (app/api/seller-leads) ---
# All three are required for the seller lead form to work. Server-side only —
# never prefix these with NEXT_PUBLIC_.

# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where new leads are delivered. Comma-separate for multiple recipients;
# the first address is used as the reply-to on the seller's confirmation.
LEAD_NOTIFY_EMAIL=jonah@royalhomesolutions.com

# The "from" address. Must be on a domain verified in Resend, otherwise
# sending fails: https://resend.com/domains
LEAD_FROM_EMAIL=Royal Home Solutions <leads@royalhomesolutions.com>

# --- Newsletter signup (app/api/newsletter) ---
# Reuses RESEND_API_KEY above. Create an audience at https://resend.com/audiences
# and paste its ID here; without it the footer signup returns a 500.
RESEND_AUDIENCE_ID=

# --- Optional ---

# Where captured leads are appended as JSONL. Defaults to ./.leads/seller-leads.jsonl
# (gitignored). Only persists on a host with a writable disk — see HANDOVER.md.
# LEAD_STORE_PATH=

# Rate limiting per IP. Defaults: 5 lead submissions / 3 newsletter signups
# per 10 minutes.
# LEAD_RATE_LIMIT=5
# LEAD_RATE_WINDOW_MS=600000
# NEWSLETTER_RATE_LIMIT=3
# NEWSLETTER_RATE_WINDOW_MS=600000
