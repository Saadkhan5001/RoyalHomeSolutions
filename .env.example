# Meta (Facebook) Pixel ID — public by design, safe to expose client-side.
NEXT_PUBLIC_META_PIXEL_ID=1033839962840918

# --- Seller lead email delivery (app/api/seller-leads) ---
# All three are required for the seller lead form to work. Server-side only —
# never prefix these with NEXT_PUBLIC_.

# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where new leads are delivered. Comma-separate for multiple recipients;
# the first address is used as the reply-to on the seller's confirmation.
LEAD_NOTIFY_EMAIL=jonah@royalhomesolutions.com

# The "from" address. Must be on a domain verified in Resend, otherwise
# sending fails: https://resend.com/domains
LEAD_FROM_EMAIL=Royal Home Solutions <leads@royalhomesolutions.com>

# --- General contact form (app/api/contact) ---
# Where general enquiries (buyers, realtors, investors, partners, vendors,
# general questions) are delivered. Comma-separate for multiple recipients.
# Optional: falls back to LEAD_NOTIFY_EMAIL above when unset, so an existing
# deploy keeps working. Set it to route general enquiries away from seller
# leads. Reuses RESEND_API_KEY and LEAD_FROM_EMAIL for sending.
CONTACT_NOTIFY_EMAIL=jonah@royalhomesolutions.com

# Scheduling link for the "Book a Call" button on /contact. PUBLIC by design —
# it is a URL a visitor clicks. Must be an absolute http(s) URL; anything else
# (or leaving it blank) hides the button entirely and the page still reads as
# complete. No calendar provider is assumed.
NEXT_PUBLIC_BOOK_CALL_URL=

# --- Newsletter signup (app/api/newsletter) ---
# Reuses RESEND_API_KEY above. Create an audience at https://resend.com/audiences
# and paste its ID here; without it the footer signup returns a 500.
RESEND_AUDIENCE_ID=

# --- Cloudflare Turnstile — free anti-bot protection ---
# REQUIRED. Every public form (seller lead, buyer interest, contact, newsletter)
# is rejected without these — the check fails closed on purpose, because the
# alternative is reopening the endpoints that were being abused.
#
# Create a free widget at https://dash.cloudflare.com → Turnstile → Add site.
# The Free plan covers this entirely; there is no paid tier involved.
#
# Site key is public and shipped to the browser. Secret key is server-only —
# never prefix it with NEXT_PUBLIC_ and never log it.
#
# The values below are Cloudflare's published "always passes" TEST keys, so a
# copied .env.local works locally straight away. REPLACE BOTH before deploying:
# they accept any token and provide no protection whatsoever.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Hostnames a solved token may come from, comma-separated. Defaults to
# royalhomesolutions.com and www.royalhomesolutions.com. Set this if the site is
# served from anywhere else — a Vercel preview deployment on *.vercel.app will
# otherwise have every submission rejected as a hostname mismatch.
# TURNSTILE_ALLOWED_HOSTNAMES=royalhomesolutions.com,www.royalhomesolutions.com

# --- Optional ---

# How long to wait for Cloudflare's siteverify call before giving up and
# rejecting the submission. Defaults to 5000ms.
# TURNSTILE_TIMEOUT_MS=5000

# Enforce hostname + action binding on Cloudflare's siteverify response.
# Defaults to on in production, off elsewhere (the official test keys answer
# with a placeholder hostname and no action, so enforcing it locally would make
# them unusable). Only set this to debug the binding itself.
# TURNSTILE_STRICT_BINDING=true

# Where captured leads are appended as JSONL. Defaults to ./.leads/seller-leads.jsonl
# (gitignored). Only persists on a host with a writable disk — see HANDOVER.md.
# LEAD_STORE_PATH=

# Rate limiting per IP, in two separate buckets (see HANDOVER.md §9d):
#   *_RATE_LIMIT   — successful submissions. Charged only when one goes through,
#                    so a rejected attempt never costs a real customer.
#   *_ABUSE_LIMIT  — total requests of any kind. Deliberately much looser, so a
#                    bot behind a shared office/mobile IP cannot lock out the
#                    people sharing that address with it.
# Defaults: 5 lead submissions / 3 newsletter signups / 30 requests each,
# per 10 minutes.
# LEAD_RATE_LIMIT=5
# LEAD_ABUSE_LIMIT=30
# LEAD_RATE_WINDOW_MS=600000
# NEWSLETTER_RATE_LIMIT=3
# NEWSLETTER_ABUSE_LIMIT=30
# NEWSLETTER_RATE_WINDOW_MS=600000
